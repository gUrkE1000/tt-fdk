{
  "name": "vereinsplaner",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "db:start": "./scripts/local-db.sh start",
    "db:reset": "./scripts/local-db.sh reset",
    "db:test": "./scripts/local-db.sh test",
    "db:psql": "./scripts/local-db.sh psql",
    "gen:types": "supabase gen types typescript --db-url \"$(./scripts/local-db.sh url)\" > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^1.3.1"
  }
