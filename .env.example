# Kopie als .env.local anlegen und ausfüllen (siehe docs/entwicklung.md).
# Nur VITE_-Variablen landen im Browser-Bundle — Geheimnisse gehören hier nicht hinein.

VITE_SUPABASE_URL=https://deine-projekt-id.supabase.co
VITE_SUPABASE_ANON_KEY=dein-public-anon-key

# Basis für Links in Benachrichtigungen und für den Registrierungs-QR-Code.
VITE_APP_URL=http://localhost:5173

# Öffentlicher VAPID-Schlüssel für Web Push (Phase 8). Bis dahin leer lassen.
VITE_VAPID_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# Serverseitig, NICHT hier eintragen — das sind Supabase-Secrets:
#   supabase secrets set APP_URL=... RESEND_API_KEY=... VAPID_PRIVATE_KEY=...
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY setzt Supabase
# für Edge Functions selbst.
